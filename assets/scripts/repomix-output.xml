import type { TurretConfig, TurretScheduleConfig } from "./TurretConfig";


export interface BossStageConfig {
    /**
     * 进入这个阶段的 HP 比例阈值。
     * - 第一阶段不写（永远是 100% 进入）
     * - 第二阶段写 0.7（HP ≤ 70% 进入）
     * - 第三阶段写 0.35（HP ≤ 35% 进入）
     */
